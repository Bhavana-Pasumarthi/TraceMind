data/logs/*
data/metrics/*
data/traces/*
data/deployments/*
data/incidents/*
!data/logs/.gitkeep
!data/metrics/.gitkeep
!data/traces/.gitkeep
!data/deployments/.gitkeep
!data/incidents/.gitkeep

# IDE / OS
.vscode/
.idea/
.DS_Store

# Postgres local volume (if bind-mounted)
pgdata/
